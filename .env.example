# Required
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Optional
PORT=3000
SITE_TITLE=Product Spotlights
# Where the SQLite database and (local) uploads live. Use a persistent volume in production.
DATA_DIR=./data
# Set to a long random string to keep admin sessions valid across restarts (auto-generated into DATA_DIR if empty)
SESSION_SECRET=
# Per-file upload cap in MB (Supabase free tier allows 50 MB per object; paid plans can raise it)
MAX_UPLOAD_MB=200
# Extra hostnames allowed for embedded videos (comma separated, in addition to YouTube / Vimeo / Loom / SharePoint / Stream)
EMBED_HOSTS=

# Page content. Leave DATABASE_URL blank to use a local SQLite file in DATA_DIR.
# For Supabase: Project Settings > Database > Connection string (URI). Tables are created automatically in a private "spotlight" schema.
DATABASE_URL=
# Optional: path to (or PEM text of) the database server's CA certificate. If set, the TLS certificate is fully verified.
DATABASE_CA=

# Supabase Storage for uploaded images and video (leave blank to store uploads on local disk)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=spotlight-media
